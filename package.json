{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "mkdir -p test-results && (tsc --noEmit > test-results/lint.log 2>&1 || (cat test-results/lint.log && exit 1)) && node scripts/design-token-lock.js",
    "typecheck": "tsc --noEmit",
    "test": "FREE_ONLY=false vitest run --exclude 'tests/e2e/**' --exclude 'tests/api/**' --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml",
    "test:repair-e2e": "FREE_ONLY=false vitest run tests/agent/realRepositoryRepairLoop.e2e.test.ts --reporter=default",
    "test:repair-benchmark": "FREE_ONLY=false vitest run tests/agent/repairAdversarialBenchmark.test.ts --reporter=default",
    "test:repair-policy-100": "FREE_ONLY=false vitest run tests/agent/repairPolicyAdversarial100.test.ts --reporter=default",
    "test:api": "FREE_ONLY=false node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:e2e": "npm run build && npm run test:api && npx playwright test",
    "test:node-production": "npm run build && node scripts/verify-node-production-runtime.mjs",
    "test:api-node-esm": "node scripts/verify-api-serverless-runtime.mjs",
    "test:production-publication": "node scripts/verify-production-publication.mjs",
    "test:artifact-isolation": "node scripts/verify-artifact-preview-isolation.mjs",
    "eval:prepare": "tsx scripts/evaluate-codebase.ts",
    "eval:heldout-coding": "tsx scripts/score-held-out-coding-v14.ts",
    "verify:free-model": "node --import tsx scripts/verify-free-model.ts",
    "deliver": "node scripts/auto-deliver.mjs",
    "check:worker": "npm run build && npx --yes wrangler@4.120.0 deploy --dry-run --config wrangler.jsonc --outdir dist-worker",
    "eval:aq-local-comparison": "tsx scripts/run-aq-official-local-comparison.ts",
    "eval:aq-local-comparison-shard": "tsx scripts/run-aq-official-local-comparison.ts",
    "eval:aq-local-comparison-aggregate": "tsx scripts/aggregate-aq-official-local-shards.ts",
    "eval:q1-quality": "tsx scripts/evaluate-q1-product-quality-gate.ts",
    "eval:claude-code-parity": "tsx scripts/evaluate-claude-code-parity-gate.ts",
    "eval:world-class-quality": "tsx scripts/evaluate-trusted-world-class-quality-gate-v2.ts",
    "eval:image-blind-quality": "tsx scripts/evaluate-image-blind-quality-v15.ts",
    "eval:image-edit-blind-quality": "tsx scripts/evaluate-image-edit-blind-quality-v1.ts",
    "eval:heldout-agent": "tsx scripts/evaluate-general-agent-heldout-v2.ts",
    "eval:heldout-agent:trusted": "tsx scripts/evaluate-general-agent-heldout-trusted-v2.ts",
    "eval:artifact-blind-quality": "tsx scripts/evaluate-artifact-blind-quality-v1.ts",
    "qualify:raster-live": "tsx scripts/qualify-raster-live-v15.ts",
    "eval:heldout-coding:comparison": "tsx scripts/evaluate-held-out-coding-comparison-v14.ts",
    "eval:trusted-answer-quality-v2": "tsx scripts/qualify-trusted-answer-quality-v2.ts",
    "eval:trusted-answer-blind-v2": "tsx scripts/qualify-trusted-answer-blind-preference-v2.ts",
    "eval:heldout-coding:trusted-comparison": "tsx scripts/evaluate-held-out-coding-trusted-comparison-v14.ts",
    "eval:heldout-agent:trusted-comparison": "tsx scripts/evaluate-general-agent-trusted-comparison-v2.ts",
    "eval:world-class-quality:legacy": "tsx scripts/evaluate-world-class-quality-gate.ts",
    "eval:world-class-quality:trusted": "tsx scripts/evaluate-trusted-world-class-quality-gate-v2.ts",
    "ingest:trusted-answer-corpus-v2": "tsx scripts/ingest-trusted-answer-corpus-v2.ts",
    "eval:heldout-agent:private": "tsx scripts/run-general-agent-private-v2.ts",
    "eval:heldout-agent:trusted-pack": "tsx scripts/assemble-general-agent-trusted-comparison-v2.ts",
    "inspect:artifact-private-corpus": "tsx scripts/inspect-artifact-private-corpus-v1.ts",
    "eval:artifact-private": "tsx scripts/run-artifact-private-heldout-v1.ts",
    "inspect:image-private-corpus": "tsx scripts/inspect-image-private-corpus-v1.ts",
    "eval:image-private": "tsx scripts/run-image-private-heldout-v1.ts",
    "eval:image-private-world-class": "tsx scripts/run-world-class-image-private-heldout-v2.ts",
    "eval:image-private-shards-verify": "tsx scripts/verify-world-class-image-private-shards-v1.ts",
    "inspect:image-edit-private-corpus": "tsx scripts/inspect-image-edit-private-corpus-v1.ts",
    "eval:image-edit-private": "tsx scripts/run-image-edit-private-heldout-v1.ts",
    "eval:image-edit-private-world-class-shard": "tsx scripts/run-world-class-image-edit-private-shard-v1.ts",
    "eval:image-edit-private-shards-verify": "tsx scripts/verify-world-class-image-edit-private-shards-v1.ts",
    "eval:aq-budgeted-day": "tsx scripts/run-aq-budgeted-day.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "express": "5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "recharts": "^3.8.1",
    "redis": "^6.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@fontsource/noto-sans-jp": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "supertest": "^7.2.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "handlebars": "4.7.10"
  }
}
