# ACOS 2.0 zero-cost AI policy
# OpenRouter is the primary external AI gateway for this project.
OPENROUTER_API_KEY=""

# Optional free-provider failover (Phase 1): Cloudflare Workers AI as the second route.
# The route stays disabled unless ORIGIN_CF_FAILOVER_ENABLED is exactly "true" AND the
# account mechanically proves Workers Free ($0) before every inference. Server-only:
# never expose these values to the browser, chat, logs, code, or pull requests.
# ORIGIN_CF_FAILOVER_ENABLED="true"
# CLOUDFLARE_ACCOUNT_ID=""
# ORIGIN_CF_PROOF_TOKEN=""
# ORIGIN_CF_AI_TOKEN=""

# Paid and automatic model routing is blocked by default.
# Keep this true in staging and production.
FREE_ONLY="true"

# Optional app URL used for self-referential links and callbacks.
APP_URL=""
PORT="3000"
NODE_ENV="development"

# Keep this public-release template limited to variables required by the
# Personal runtime. AI Studio treats declared credentials as app requirements.
